{
  "name": "proto2html",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Prototype HTML/React du duel \u00ab Soustraction \u00bb (proto 2, test de gameplay hors Unity)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
