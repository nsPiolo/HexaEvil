#!/usr/bin/env bash
# Hook Git versionné — voir CONTRIBUTING.md §1 pour l'installation
# (git config core.hooksPath .githooks)
set -e

ROOT_DIR="$(git rev-parse --show-toplevel)"

if ! command -v node >/dev/null 2>&1; then
  echo "⚠️  Node.js introuvable : le hook pre-commit (contrôle du lexique) est ignoré."
  echo "    Installez Node.js pour bénéficier de la vérification automatique."
  exit 0
fi

node "$ROOT_DIR/tools/hooks/check-lexicon.mjs"
