  "version": "0.1.0",
  "type": "module",
  "description": "Prototype HTML/React de « Sinner's Bet » (proto 4)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
